NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cprime_mall
DB_USER=cprime_app
DB_PASSWORD=replace-this-password
DB_CONNECTION_LIMIT=10

# Optional hostnames. Requests are routed by Host header in production.
CORPORATE_HOST=corporate.chachaprime.com
MALL_HOST=chachaprime.com
SERVICES_HOST=services.chachaprime.com
SOURCE_HOST=source.chachaprime.com
ADMIN_HOST=admin.chachaprime.com